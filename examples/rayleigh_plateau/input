# Parallelization
Partition : 2 2 2

# Mesh definition
Lx : 1.0
Ly : 1.0
Lz : 1.0
nx : 64
ny : 64
nz : 64

# monitor file name
Monitor File Name : puppic

# Interface reconstruction (case insensitive; defaults to plicnet)
Reconstruction method : jibben

# Ligament definiton
Ligament radius :           0.10
Ligament center :           0 0 0
# Perturbation amplitude :    0.1
Perturbation amplitude :    0.02
Perturbation mode :         1

# Velocity field
Initial velocity :           0 0 0

# Fluid properties
Liquid dynamic viscosity :    1.0e-3
Gas dynamic viscosity :       1.8e-5
Liquid density :              1000
Gas density :                 1
Surface tension coefficient : 0.072
# Surface tension coefficient : 0.00002

# Time integration
Max timestep size : 0.05
Max cfl number :    0.25
Max time :          60

# Pressure solver
Pressure tolerance : 1e-6
Pressure iteration : 100

# Implicit velocity solver
Implicit tolerance : 1e-6
Implicit iteration : 100

# Ensight output
Ensight output period : 1e-1
 
